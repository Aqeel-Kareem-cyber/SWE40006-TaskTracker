**/*.key
**/appsettings.*.local.json
**/.vs/
**/.vscode/
**/.idea/
**/.DS_Store
**/node_modules/
**/playwright-report/
.git/
.github/
docs/
deploy/
scripts/
*.md
docker-compose*.yml
Dockerfile
.dockerignore
