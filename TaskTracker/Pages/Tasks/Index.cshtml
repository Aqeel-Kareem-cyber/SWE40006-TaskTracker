@page
@model TaskTracker.Pages.Tasks.IndexModel

@{
    ViewData["Title"] = "Tasks";
}

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-4">

        <div>
            <h1 class="fw-bold mb-2">Task Management</h1>
            <p class="text-muted mb-0">Manage tasks and deadlines.</p>
        </div>

        <a asp-page="/Index"
           class="btn btn-outline-primary">
            ← Dashboard
        </a>

    </div>


    <div class="card shadow-sm mb-5">

        <div class="card-body p-4">

            <h4 class="fw-semibold mb-4">New Task</h4>

            <form method="post">

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">

                    <label asp-for="NewTask.Title"
                           class="form-label">
                        Task Name
                    </label>

                    <input asp-for="NewTask.Title"
                           class="form-control"
                           placeholder="Enter task name" />

                    <span asp-validation-for="NewTask.Title"
                          class="text-danger"></span>

                </div>


                <div class="mb-3">

                    <label asp-for="NewTask.Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="NewTask.Description"
                              class="form-control"
                              rows="3"
                              placeholder="Task details"></textarea>

                    <span asp-validation-for="NewTask.Description"
                          class="text-danger"></span>

                </div>


                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label asp-for="NewTask.Priority"
                               class="form-label">
                            Priority
                        </label>

                        <select asp-for="NewTask.Priority"
                                class="form-select">

                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>

                        </select>

                    </div>


                    <div class="col-md-4 mb-3">

                        <label asp-for="NewTask.Status"
                               class="form-label">
                            Status
                        </label>

                        <select asp-for="NewTask.Status"
                                class="form-select">

                            <option value="To Do">To Do</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Completed">Completed</option>

                        </select>

                    </div>


                    <div class="col-md-4 mb-3">

                        <label asp-for="NewTask.DueDate"
                               class="form-label">
                            Due Date
                        </label>

                        <input asp-for="NewTask.DueDate"
                               type="date"
                               class="form-control" />

                    </div>

                </div>


                <button type="submit"
                        class="btn btn-primary px-4">
                    Create Task
                </button>

            </form>

        </div>

    </div>


    <div class="d-flex justify-content-between align-items-center mb-3">

        <h3 class="fw-semibold mb-0">All Tasks</h3>

        <span class="badge bg-secondary">
            @Model.Tasks.Count Total
        </span>

    </div>


    <div class="card shadow-sm">

        <div class="card-body p-4">

            @if (Model.Tasks.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Task</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Due Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var task in Model.Tasks)
                            {
                                var priorityClass = task.Priority switch
                                {
                                    "High" => "bg-danger",
                                    "Medium" => "bg-warning text-dark",
                                    _ => "bg-success"
                                };

                                var statusClass = task.Status switch
                                {
                                    "Completed" => "bg-success",
                                    "In Progress" => "bg-primary",
                                    _ => "bg-secondary"
                                };

                                <tr>

                                    <td>
                                        <div class="fw-semibold">
                                            @task.Title
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(task.Description))
                                        {
                                            <small class="text-muted">
                                                @task.Description
                                            </small>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge @priorityClass">
                                            @task.Priority
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge @statusClass">
                                            @task.Status
                                        </span>
                                    </td>

                                    <td>
                                        @(task.DueDate?.ToString("dd MMM yyyy") ?? "Not set")
                                    </td>

                                    <td>

                                        <div class="d-flex flex-wrap gap-2">

                                            <a asp-page="./Edit"
                                               asp-route-id="@task.Id"
                                               class="btn btn-outline-primary btn-sm">
                                                Edit
                                            </a>

                                            @if (task.Status != "Completed")
                                            {
                                                <form method="post"
                                                      asp-page-handler="Complete"
                                                      asp-route-id="@task.Id">

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm">
                                                        Complete
                                                    </button>

                                                </form>
                                            }

                                            <form method="post"
                                                  asp-page-handler="Delete"
                                                  asp-route-id="@task.Id"
                                                  onsubmit="return confirm('Delete this task?');">

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

            @if (!Model.Tasks.Any())
            {
                <div class="text-center py-5">

                    <h5 class="fw-semibold">No tasks found</h5>

                    <p class="text-muted mb-0">
                        Create a task to get started.
                    </p>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}